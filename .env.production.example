ENVIRONMENT=production
DEBUG=false
DATABASE_URL=REPLACE_WITH_RENDER_POSTGRES_URL
SECRET_KEY=REPLACE_WITH_STABLE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
FRONTEND_URL=https://REPLACE_WITH_FRONTEND_HOST
CORS_ALLOWED_ORIGINS=https://REPLACE_WITH_FRONTEND_HOST

VITE_API_URL=https://REPLACE_WITH_API_HOST/api/v1
VITE_WS_URL=wss://REPLACE_WITH_API_HOST/api/v1

LLM_PROVIDERS=groq,gemini,openrouter
GROQ_API_KEY=REPLACE_WITH_GROQ_KEY
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TPM_LIMIT=6000
GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TPM_LIMIT=6000
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_KEY
OPENROUTER_MODEL=REPLACE_WITH_OPENROUTER_MODEL
OPENROUTER_TPM_LIMIT=6000
LLM_TPM_LIMIT=6000
LLM_CONCURRENCY=1
LLM_MAX_RETRIES=5
LLM_BATCH_MAX_PROMPT_TOKENS=5000
LLM_BATCH_LARGE_PROMPT_TOKENS=2000
LLM_BATCH_PROVIDER_ORDER=gemini,groq,openrouter

CHATBOT_ENABLED=false
CHATBOT_MODE=retrieval
CHATBOT_PROVIDER=openai-compatible
CHATBOT_BASE_URL=https://api.groq.com/openai
CHATBOT_API_KEY=REPLACE_WITH_CHATBOT_PROVIDER_KEY
CHATBOT_FALLBACK_BASE_URL=
CHATBOT_FALLBACK_API_KEY=REPLACE_WITH_CHATBOT_FALLBACK_KEY
CHATBOT_FALLBACK_MODEL=
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY
CHATBOT_MODEL=openai/gpt-oss-20b
CHATBOT_ROUTER_MODEL=openai/gpt-oss-20b
CHATBOT_MAX_TOKENS=600
CHATBOT_TEMPERATURE=0.1
CHATBOT_RETRIES=1
CHATBOT_TOP_K=3
CHATBOT_MIN_SCORE=4.0
CHATBOT_TIMEOUT_SECONDS=8
CHATBOT_USER_PER_MINUTE=20
CHATBOT_USER_PER_DAY=200
CHATBOT_GUEST_PER_MINUTE=5
CHATBOT_TOKENS_PER_MINUTE=7500
CHATBOT_TOKENS_PER_DAY=190000
CHATBOT_REQUESTS_PER_MINUTE=30
CHATBOT_REQUESTS_PER_DAY=1000
CHATBOT_CHUNK_WORDS=400
CHATBOT_CHUNK_OVERLAP=50
RAG_ENABLED=false
CHATBOT_VECTOR_ENABLED=false
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RAG_TOP_K=5
RAG_MIN_SCORE=0.55
KB_PATH=/app/kb

INTERVIEW_LLM_PROVIDER=groq
INTERVIEW_LLM_API_KEY=REPLACE_WITH_INTERVIEW_LLM_KEY
INTERVIEW_LLM_BASE_URL=https://api.groq.com/openai
INTERVIEW_LLM_MODEL=openai/gpt-oss-20b
INTERVIEW_LLM_TIMEOUT_SECONDS=12
INTERVIEW_STT_API_KEY=REPLACE_WITH_STT_KEY
INTERVIEW_STT_BASE_URL=https://api.groq.com/openai
INTERVIEW_STT_MODEL=whisper-large-v3-turbo
INTERVIEW_STT_MAX_AUDIO_BYTES=10485760
INTERVIEW_STT_MAX_DURATION_SECONDS=180
INTERVIEW_STT_REQUESTS_PER_MINUTE=5

STORAGE_BACKEND=s3
S3_ENDPOINT_URL=REPLACE_WITH_S3_COMPATIBLE_ENDPOINT
S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET_NAME
S3_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_ACCESS_KEY
S3_REGION=auto
INTERVIEW_VIDEO_STORAGE_BACKEND=gdrive
GOOGLE_SERVICE_ACCOUNT_JSON=/etc/secrets/drive-service-account.json
GDRIVE_FOLDER_ID=REPLACE_WITH_SHARED_DRIVE_FOLDER_ID
INTERVIEW_VIDEO_STORAGE_PATH=/tmp/internsphere/interview_recordings
VIDEO_RETENTION_DAYS=30
VIDEO_MAX_MB=250
VIDEO_MAX_SECONDS=1200
INTERVIEW_VIDEO_MAX_CHUNK_BYTES=5242880

RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_URL=REPLACE_WITH_REDIS_URL
TRUSTED_PROXIES=
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
ADMIN_EMAILS=REPLACE_WITH_ADMIN_EMAILS
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_RESUME_SIZE_MB=5
REQUIRE_EMAIL_VERIFICATION=true
REQUIRE_COMPANY_EMAIL_VERIFICATION=false
INTERVIEW_AUTO_CANCEL_GRACE_MINUTES=60

MAIL_SERVER=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM=REPLACE_WITH_VERIFIED_SENDER
MAIL_USE_TLS=true
