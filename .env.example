POSTGRES_DB=internship_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/internship_platform
SECRET_KEY=replace-with-a-long-random-fixed-development-secret
FRONTEND_URL=http://localhost:5174
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
TRUSTED_PROXIES=
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REDIS_URL=
REQUIRE_COMPANY_EMAIL_VERIFICATION=false
NOTIFY_EMAIL_ON_ROLE_CLOSE=false
ADMIN_USERNAME=k.meghana
ADMIN_EMAIL=k.meghana@gmail.com
ADMIN_PASSWORD=change-me
CHATBOT_ENABLED=true
CHATBOT_MODE=retrieval
CHATBOT_PROVIDER=openai-compatible
CHATBOT_BASE_URL=https://api.groq.com/openai
CHATBOT_API_KEY=
CHATBOT_MODEL=openai/gpt-oss-20b
CHATBOT_ROUTER_MODEL=openai/gpt-oss-20b
CHATBOT_MAX_TOKENS=600
CHATBOT_TEMPERATURE=0.1
CHATBOT_RETRIES=1
CHATBOT_TOP_K=3
CHATBOT_MIN_SCORE=4.0
CHATBOT_TIMEOUT_SECONDS=8
CHATBOT_USER_PER_MINUTE=20
CHATBOT_USER_PER_DAY=200
CHATBOT_GUEST_PER_MINUTE=5
CHATBOT_TOKENS_PER_MINUTE=7000
CHATBOT_TOKENS_PER_DAY=180000
CHATBOT_REQUESTS_PER_MINUTE=30
CHATBOT_REQUESTS_PER_DAY=1000
CHATBOT_CHUNK_WORDS=400
CHATBOT_CHUNK_OVERLAP=50
RAG_ENABLED=false
CHATBOT_VECTOR_ENABLED=false
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RAG_TOP_K=5
RAG_MIN_SCORE=0.55
KB_PATH=kb
# Ordered OpenAI-compatible providers for interview generation/evaluation.
LLM_PROVIDERS=groq,gemini,openrouter
LLM_TPM_LIMIT=6000
LLM_CONCURRENCY=1
LLM_MAX_RETRIES=5
LLM_BATCH_MAX_PROMPT_TOKENS=5000
LLM_BATCH_LARGE_PROMPT_TOKENS=2000
LLM_BATCH_PROVIDER_ORDER=gemini,groq,openrouter
INTERVIEW_LLM_TIMEOUT_SECONDS=12

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TPM_LIMIT=6000
GROQ_CONCURRENCY=1

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TPM_LIMIT=6000
GEMINI_CONCURRENCY=1

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_TPM_LIMIT=6000
OPENROUTER_CONCURRENCY=1

# Legacy Groq settings remain supported when GROQ_* values are unset.
INTERVIEW_LLM_BASE_URL=https://api.groq.com/openai
INTERVIEW_LLM_PROVIDER=groq
INTERVIEW_LLM_MODEL=openai/gpt-oss-20b
INTERVIEW_LLM_API_KEY=
INTERVIEW_PROCTORING_MAX_VIOLATIONS=3
INTERVIEW_ALLOWED_PROVIDER_HOSTS=["api.groq.com","generativelanguage.googleapis.com","openrouter.ai"]
INTERVIEW_STT_BASE_URL=https://api.groq.com/openai
INTERVIEW_STT_MODEL=whisper-large-v3-turbo
INTERVIEW_STT_API_KEY=
INTERVIEW_STT_TIMEOUT_SECONDS=45
INTERVIEW_STT_MAX_AUDIO_BYTES=10485760
INTERVIEW_STT_MAX_DURATION_SECONDS=180
INTERVIEW_STT_REQUESTS_PER_MINUTE=5
INTERVIEW_FFPROBE_PATH=ffprobe
INTERVIEW_VIDEO_STORAGE_PATH=backend/storage/interview_recordings
INTERVIEW_VIDEO_MAX_CHUNK_BYTES=5242880
INTERVIEW_VIDEO_MAX_BYTES=262144000
INTERVIEW_VIDEO_MAX_DURATION_SECONDS=1200
INTERVIEW_VIDEO_RETENTION_DAYS=30
STORAGE_BACKEND=local
# Interview recordings can separately use local or Google Drive storage.
INTERVIEW_VIDEO_STORAGE_BACKEND=local
# S3-compatible asset storage (Cloudflare R2, Supabase Storage, Backblaze B2).
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Service-account JSON file path or base64-encoded JSON content.
GOOGLE_SERVICE_ACCOUNT_JSON=
GDRIVE_FOLDER_ID=
VIDEO_RETENTION_DAYS=30
VIDEO_MAX_MB=250
VIDEO_MAX_SECONDS=1200
VITE_INTERVIEW_TTS_PROVIDER=browser
FRONTEND_PORT=5174
VITE_API_URL=http://localhost:8010/api/v1
VITE_WS_URL=ws://localhost:8010/api/v1
