# Copy to .env for local development.
POSTGRES_DB=internship_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/internship_platform
SECRET_KEY=replace-with-a-long-random-development-secret
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_RESUME_SIZE_MB=5
RESUME_STORAGE_PATH=storage/resumes
ADMIN_SIGNUP_KEY=Meghan@123456789
