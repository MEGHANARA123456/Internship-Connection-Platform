# Copy to .env on the deployment host. Use secret values from a secret manager.
POSTGRES_DB=internship_platform
POSTGRES_USER=internship_app
POSTGRES_PASSWORD=replace-with-a-strong-unique-password
DATABASE_URL=postgresql+asyncpg://internship_app:replace-with-a-strong-unique-password@db:5432/internship_platform
SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_URL=https://your-domain.example
VITE_API_BASE_URL=https://your-domain.example/api/v1
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_RESUME_SIZE_MB=5
RESUME_STORAGE_PATH=/var/lib/internship-platform/resumes
ADMIN_SIGNUP_KEY=replace-with-a-long-admin-bootstrap-key
